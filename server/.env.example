# Copy this file to .env and fill in the real value. Never commit .env.
# The link to the MongoDB database (Atlas online, or your local one)
MONGO_URL=

# Sign-in (see "Setting up Google sign-in" in the README)
# My own Google email. Only this email gets in. Capitals and spaces don't matter
OWNER_EMAIL=
# The client id from Google's console. It tells Google which app the sign-in is for
GOOGLE_CLIENT_ID=
